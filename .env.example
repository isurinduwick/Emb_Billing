APP_NAME="Emerald Bay Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Database (SQLite for quick local start) ---
DB_CONNECTION=sqlite
# For production MySQL, comment the line above and use:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=emeraldbay
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- SMS Gateway (notify.lk style - adjust in app/Services/SmsService.php for other providers) ---
SMS_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=EmeraldBay

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved utility template name; if empty a plain text message is attempted
WHATSAPP_TEMPLATE=
